rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.matches('.*@natacaocriativa\\.com$') &&
        request.auth.token.email_verified == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Quiz Questions Collection
    match /quiz_questions/{questionId} {
      allow read: if true; // Public read access for questions
      allow create, update, delete: if isAdmin();
    }

    // Quiz Responses Collection
    match /quiz_responses/{responseId} {
      // Allow user to write their own quiz submission
      allow create: if true;

      // Allow users to read their own response, or admins/staff to read all responses
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.studentId == request.auth.uid ||
          resource.data.studentEmail == request.auth.token.email
        )
      );

      // Allow updating own response or admin override
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.studentId == request.auth.uid
      );

      // Delete reserved for admin
      allow delete: if isAdmin();
    }
  }
}
